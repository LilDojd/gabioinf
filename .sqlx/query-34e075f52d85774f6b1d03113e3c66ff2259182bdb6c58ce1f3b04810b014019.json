{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                comment_id AS \"comment_id?: CommentId\",\n                emoji,\n                COUNT(*) AS \"count!\",\n                COALESCE(bool_or(guest_id = $2::BIGINT), false) AS \"reacted!\"\n            FROM reactions\n            WHERE post_slug = $1\n            GROUP BY comment_id, emoji\n            ",
