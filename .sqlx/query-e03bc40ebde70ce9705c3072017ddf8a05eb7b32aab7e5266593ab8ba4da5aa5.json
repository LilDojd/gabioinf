{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    g.id AS \"id: GuestbookId\",\n                    g.message,\n                    g.signature,\n                    g.created_at,\n                    g.updated_at,\n                    g.author_id AS \"author_id: GuestId\",\n                    u.username AS author_username\n                FROM guestbook g JOIN guests u ON u.id = g.author_id\n                WHERE (g.created_at, g.id) < ($1, $2)\n                ORDER BY g.created_at DESC, g.id DESC\n                LIMIT $3\n                ",
