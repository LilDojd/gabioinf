{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                c.id AS \"id: CommentId\",\n                c.parent_id AS \"parent_id?: CommentId\",\n                g.username,\n                g.github_id AS \"github_id: GithubId\",\n                c.body,\n                c.created_at\n            FROM comments c\n            JOIN guests g ON g.id = c.author_id\n            WHERE c.post_slug = $1\n            ORDER BY c.created_at, c.id\n            ",
